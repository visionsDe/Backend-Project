# Database
MYSQL_HOST=mysql
MYSQL_USER=sampleapp
MYSQL_PASSWORD=change_me
MYSQL_DB=sampleapp

# Auth
SECRET_KEY=change_me_to_random_long_string
ALGORITHM=HS256
ENC_SECURE_KEY=change_me_fernet_key_32_bytes_url_safe_base64

# Stripe (multi-country routing)
# Region resolution lives in app/utils/stripe_client.py — supplier country ISO
# picks PRIMARY vs SECONDARY. Leaving a region's keys empty falls back to the
# plain STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET below.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_DEFAULT_WEBSITE=https://example.com
STRIPE_PRIMARY_SECRET_KEY=
STRIPE_PRIMARY_WEBHOOK_SECRET=
STRIPE_PRIMARY_WEBSITE=
STRIPE_SECONDARY_SECRET_KEY=
STRIPE_SECONDARY_WEBHOOK_SECRET=
STRIPE_SECONDARY_WEBSITE=

# Apple In-App Purchase
APPLE_BUNDLE_ID=com.sampleapp.app
APPLE_APP_APPLE_ID=0000000000
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
APPLE_PRIVATE_KEY_FILE=./AuthKey_XXXXXXXXXX.p8     # not committed — see .gitignore
APPLE_ROOT_CAS_DIR=./apple_root_cas                # directory of Apple root .cer files
APPLE_WEBHOOK_ENVIRONMENT=sandbox                  # or "production"

# Google Play
GOOGLE_CREDENTIALS_FILE=./google-service-account.json
GOOGLE_TOKEN_SCOPE=https://www.googleapis.com/auth/androidpublisher
GOOGLE_WEBHOOK_AUDIENCE=https://your-backend.example.com/api/webhooks/google-play
GOOGLE_WEBHOOK_SERVICE_ACCOUNT_EMAIL=rtdn-pubsub@your-project.iam.gserviceaccount.com

# AI
OPENAI_API_KEY=sk-xxx
AI_PROVIDER_DEFAULT=openai

# Misc
API_BASE_URL=http://localhost:8000
FILE_DIR_PATH=/tmp

# CORS allowlist — comma-separated origins (no spaces).
# Leave empty for development; credentialed requests only work with explicit origins.
ALLOWED_ORIGINS=

# Startup toggles
ENABLE_SCHEDULER=false
ENABLE_EXCEPTION_LOGGING=false
